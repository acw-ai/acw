# ==============================================================================
# ACW - Open-Source Voice & PBX After-Call Work (Configuration)
# ==============================================================================

# Server Network
PORT=3100
HOST=127.0.0.1
SIMULATE=false

# Branding
BRAND_NAME=ACW
BRAND_SUBTITLE="After-Call Work & PBX Intelligence"

# Telephony Driver: 'webhook', '3cx', 'asterisk', or 'freeswitch'
TELEPHONY_DRIVER=webhook

# Telephony Inbound Webhook Security (optional secret/bearer token)
# TELEPHONY_WEBHOOK_TOKEN=your-telephony-webhook-secret

# 3CX PBX Connection (Required only if TELEPHONY_DRIVER=3cx)
# PBX_URL=https://your-3cx-domain.3cx.ca
# PBX_CLIENT_ID=your-api-client-id
# PBX_CLIENT_SECRET=your-api-client-secret

# Asterisk / FreePBX Connection (Required only if TELEPHONY_DRIVER=asterisk)
# ASTERISK_ARI_URL=http://127.0.0.1:8088
# ASTERISK_ARI_USER=acw
# ASTERISK_ARI_PASSWORD=your_ari_password
# ASTERISK_APP_NAME=acw

# FreeSWITCH / FusionPBX Connection (Required only if TELEPHONY_DRIVER=freeswitch)
# FREESWITCH_ESL_HOST=127.0.0.1
# FREESWITCH_ESL_PORT=8021
# FREESWITCH_ESL_PASSWORD=ClueCon

# Queue & Disposition Enforcement
ENFORCE_DISPOSITION=true
REQUIRE_UNANSWERED_OUTBOUND=true
SKIP_INTERNAL_CALLS=true
INTERNAL_NUMBER_MAX_LENGTH=4
GUARD_INTERVAL_MS=20000

# Database (sqlite or mysql)
DB_DRIVER=sqlite
DB_PATH=data/acw.db

# If using MySQL:
# DB_DRIVER=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=acw_user
# MYSQL_PASSWORD=strong_password
# MYSQL_DATABASE=acw_db

# Security & Authentication
SUPERVISOR_PASSWORD=change_this_to_a_secure_password
SESSION_SECRET=generate_with_openssl_rand_hex_32
SESSION_HOURS=12
COOKIE_SECURE=false

# CRM & Integrations (Universal Webhooks)
# WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/123/
# WEBHOOK_SECRET=optional_webhook_signing_secret
# CRM_SCREENPOP_URL=https://app.hubspot.com/contacts/search?query={PHONE}

# AI Engine (openai, ollama, or none)
AI_PROVIDER=none
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# OLLAMA_URL=http://localhost:11434
